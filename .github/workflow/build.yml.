name: Build APK (test)

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-24.04
    timeout-minutes: 180
    env:
      NDK_VERSION: 30.0.16248370
      CMAKE_VERSION: 3.30.4
    steps:
      - name: Check out the code and submodules
        uses: actions/checkout@v4
        with:
          submodules: recursive

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - name: Install helper tools
        run: sudo apt-get update && sudo apt-get install -y bzip2 patch xz-utils

      - name: Install the Android NDK, CMake and platform
        run: |
          SDKM="$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager"
          yes | "$SDKM" --licenses > /dev/null || true
          "$SDKM" "ndk;$NDK_VERSION" "cmake;$CMAKE_VERSION" "platforms;android-36"
          # The runner has its own NDK variables; point them at the version the project needs
          {
            echo "ANDROID_NDK=$ANDROID_HOME/ndk/$NDK_VERSION"
            echo "ANDROID_NDK_HOME=$ANDROID_HOME/ndk/$NDK_VERSION"
            echo "ANDROID_NDK_ROOT=$ANDROID_HOME/ndk/$NDK_VERSION"
          } >> "$GITHUB_ENV"

      - name: Restore prebuilt libraries (if cached)
        uses: actions/cache@v4
        with:
          path: android/deps/out
          key: deps-${{ hashFiles('android/deps/build_deps.sh', 'android/deps/build_ffmpeg.sh', 'android/deps/sdl-aaudio-resume.patch') }}

      - name: Build SDL3, shaderc and headers
        run: bash android/deps/build_deps.sh

      - name: Build FFmpeg
        run: |
          if [ ! -f android/deps/out/lib/libavcodec.so ]; then
            ANDROID_NDK_LINUX="$ANDROID_HOME/ndk/$NDK_VERSION" bash android/deps/build_ffmpeg.sh
          fi

      - name: Make this a separate app (so your installed one is not replaced)
        run: |
          sed -i 's|applicationId = "com.botwrecomp.android"|applicationId = "com.botwrecomp.android.test"|' android/botwrecompandroid/app/build.gradle.kts
          grep -n applicationId android/botwrecompandroid/app/build.gradle.kts

      - name: Build the APK
        working-directory: android/botwrecompandroid
        run: |
          chmod +x gradlew
          ./gradlew --no-daemon assembleRelease

      - name: Upload the APK
        uses: actions/upload-artifact@v4
        with:
          name: botw-apk
          path: android/botwrecompandroid/app/build/outputs/apk/release/*.apk
          if-no-files-found: error
